# 将需要的内容合并到项目现有 .codex/config.toml。
# 不要在已有配置上盲目覆盖。

[agents]
max_threads = 4
max_depth = 1
job_max_runtime_seconds = 1800

# Note:
# job_max_runtime_seconds is primarily the default runtime limit for
# spawn_agents_on_csv-style batch workers. Do not rely on it as a universal
# timeout for every normally spawned subagent.
